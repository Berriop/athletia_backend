generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String?
  birthDate       DateTime?
  gender          Gender?
  heightCm        Float?
  weightKg        Float?
  experienceLevel ExperienceLevel?
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  injuries        Injury[]
  meals           Meal[]
  sleepLogs       SleepLog[]
  workouts        Workout[]

  @@index([createdAt])
}

model Workout {
  id              String   @id @default(uuid())
  title           String
  description     String?
  bodyPart        BodyPart
  durationMinutes Int
  energyLevel     Int
  fatigueLevel    Int
  painLevel       Int
  date            DateTime
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Meal {
  id        String   @id @default(uuid())
  name      String
  calories  Int
  mealType  MealType
  proteinG  Float
  carbsG    Float
  fatG      Float
  date      DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([date])
  @@index([mealType])
  @@index([userId, date])
}

model SleepLog {
  id            String   @id @default(uuid())
  hoursSlept    Float
  sleepQuality  Int
  hadNightmares Boolean  @default(false)
  stressLevel   Int
  notes         String?
  date          DateTime
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Injury {
  id         String   @id @default(uuid())
  bodyArea   String
  injuryName String
  severity   Int
  isActive   Boolean  @default(true)
  notes      String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([bodyArea])
  @@index([userId, isActive])
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum BodyPart {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  CORE
  CARDIO
  FULL_BODY
  OTHER
}
